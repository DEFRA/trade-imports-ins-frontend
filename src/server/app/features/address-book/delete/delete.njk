{% extends "shared/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block journeyContent %}
  <h1 class="govuk-heading-l">{{ copy.delete.title }}</h1>

  {% set addressHtml %}{% for line in postalLines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}{% endset %}
  {{ govukSummaryList({
    rows: [{
      key: { text: copy.delete.summaryAddress },
      value: { html: addressHtml }
    }]
  }) }}

  <p class="govuk-body">{{ copy.delete.confirmation }}</p>
  <p class="govuk-body">{{ copy.delete.warning }}</p>

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    <div class="govuk-button-group">
      {{ govukButton({
        text: copy.delete.confirm,
        classes: "govuk-button--warning"
      }) }}
      <a class="govuk-link" href="{{ cancelHref }}">{{ copy.delete.cancel }}</a>
    </div>
  </form>
{% endblock %}
