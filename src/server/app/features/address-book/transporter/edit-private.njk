{% extends "shared/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "address-book/transporter/transporter-fields.njk" import transporterNameAndApprovalNumber, transporterPostalLines, transporterChosenCountry, transporterContactDetails %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  <h1 class="govuk-heading-l">{{ copy.title }}</h1>

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />

    <h2 class="govuk-heading-m">{{ fieldCopy.addressHeading }}</h2>

    {{ transporterNameAndApprovalNumber({ copy: fieldCopy, formValues: formValues, errors: errors }) }}
    {{ transporterPostalLines({ copy: fieldCopy, formValues: formValues, errors: errors }) }}
    {{ transporterChosenCountry({
      copy: fieldCopy,
      errors: errors,
      countryItems: countryItems,
      selectedCountryCode: formValues.countryCode
    }) }}

    <h2 class="govuk-heading-m">{{ fieldCopy.contactHeading }}</h2>

    {{ transporterContactDetails({ copy: fieldCopy, formValues: formValues, errors: errors }) }}

    <div class="govuk-button-group">
      {{ govukButton({ text: copy.save }) }}
      {{ govukButton({
        text: copy.cancel,
        name: "cancel",
        value: "true",
        classes: "govuk-button--secondary"
      }) }}
    </div>
  </form>
{% endblock %}
