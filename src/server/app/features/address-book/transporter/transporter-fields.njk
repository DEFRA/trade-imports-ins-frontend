{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}

{% macro transporterNameAndApprovalNumber(params) %}
  {% set copy = params.copy %}
  {% set formValues = params.formValues %}
  {% set errors = params.errors %}

  {{ govukInput({
    label: { text: copy.fields.name },
    id: "name",
    name: "name",
    value: formValues.name,
    errorMessage: errors.name and { text: errors.name }
  }) }}

  {% if params.withApprovalNumber %}
    {{ govukInput({
      label: { text: copy.fields.approvalNumber },
      id: "approvalNumber",
      name: "approvalNumber",
      value: formValues.approvalNumber,
      errorMessage: errors.approvalNumber and { text: errors.approvalNumber }
    }) }}
  {% endif %}
{% endmacro %}

{% macro transporterPostalLines(params) %}
  {% set copy = params.copy %}
  {% set formValues = params.formValues %}
  {% set errors = params.errors %}

  {{ govukInput({
    label: { text: copy.fields.addressLine1 },
    id: "addressLine1",
    name: "addressLine1",
    value: formValues.addressLine1,
    autocomplete: "address-line1",
    errorMessage: errors.addressLine1 and { text: errors.addressLine1 }
  }) }}

  {{ govukInput({
    label: { text: copy.fields.addressLine2 },
    id: "addressLine2",
    name: "addressLine2",
    value: formValues.addressLine2,
    autocomplete: "address-line2",
    errorMessage: errors.addressLine2 and { text: errors.addressLine2 }
  }) }}

  {{ govukInput({
    label: { text: copy.fields.townOrCity },
    id: "townOrCity",
    name: "townOrCity",
    value: formValues.townOrCity,
    autocomplete: "address-level2",
    classes: "govuk-!-width-one-half",
    errorMessage: errors.townOrCity and { text: errors.townOrCity }
  }) }}

  {{ govukInput({
    label: { text: copy.fields.county },
    id: "county",
    name: "county",
    value: formValues.county,
    classes: "govuk-!-width-one-half",
    errorMessage: errors.county and { text: errors.county }
  }) }}

  {{ govukInput({
    label: { text: copy.fields.postcode },
    id: "postcode",
    name: "postcode",
    value: formValues.postcode,
    autocomplete: "postal-code",
    classes: "govuk-!-width-one-half",
    errorMessage: errors.postcode and { text: errors.postcode }
  }) }}
{% endmacro %}

{% macro transporterChosenCountry(params) %}
  {% set copy = params.copy %}
  {% set errors = params.errors %}

  {{ govukSelect({
    id: "countryCode",
    name: "countryCode",
    label: { text: copy.fields.countryCode },
    items: params.countryItems,
    value: params.selectedCountryCode,
    classes: "govuk-!-width-one-half",
    errorMessage: errors.countryCode and { text: errors.countryCode }
  }) }}
{% endmacro %}

{% macro transporterFixedCountry(params) %}
  {% set copy = params.copy %}
  {% set errors = params.errors %}

  {# A commercial transporter can only be in Northern Ireland, so the country
     is shown and cannot be changed. The disabled select carries no value
     to the server, so the hidden field beside it posts the one the page
     fixed. #}
  {{ govukSelect({
    id: "countryCode",
    name: "countryCodeDisplay",
    label: { text: copy.fields.countryCode },
    items: [{ value: params.countryCode, text: params.countryLabel, selected: true }],
    disabled: true,
    classes: "govuk-!-width-one-half",
    errorMessage: errors.countryCode and { text: errors.countryCode }
  }) }}
  <input type="hidden" name="countryCode" value="{{ params.countryCode }}" />
{% endmacro %}

{% macro transporterContactDetails(params) %}
  {% set copy = params.copy %}
  {% set formValues = params.formValues %}
  {% set errors = params.errors %}

  {{ govukInput({
    label: { text: copy.fields.email },
    id: "email",
    name: "email",
    value: formValues.email,
    autocomplete: "email",
    errorMessage: errors.email and { text: errors.email }
  }) }}

  {{ govukInput({
    label: { text: copy.fields.phone },
    id: "phone",
    name: "phone",
    value: formValues.phone,
    autocomplete: "tel",
    classes: "govuk-!-width-two-thirds",
    hint: { text: copy.phoneHint },
    errorMessage: errors.phone and { text: errors.phone }
  }) }}
{% endmacro %}
