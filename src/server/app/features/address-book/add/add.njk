{% extends "shared/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "address-book/address-fields.njk" import addressFields %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  <span class="govuk-caption-l">{{ copy.add.caption }}</span>
  <h1 class="govuk-heading-l">{{ copy.add.title }}</h1>

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />
    {% if addMode != addModes.ADDRESS_BOOK %}
      <input type="hidden" name="journey-type" value="{{ handshakeContext.journeyType }}" />
      <input type="hidden" name="notification-id" value="{{ handshakeContext.notificationId }}" />
      <input type="hidden" name="fulfilment-id" value="{{ handshakeContext.fulfilmentId }}" />
      <input type="hidden" name="handshake-token" value="{{ handshakeContext.handshakeToken }}" />
    {% endif %}

    {{ addressFields({
      copy: copy,
      formValues: formValues,
      countryItems: countryItems,
      errors: errors
    }) }}

    {% if addMode == addModes.ROLE_HANDSHAKE %}
      <div class="govuk-button-group">
        {{ govukButton({
          text: copy.add.saveAndSelect,
          name: "action",
          value: addressLanding.SELECT
        }) }}
        {{ govukButton({
          text: copy.add.saveAndReturnToAddressPage,
          name: "action",
          value: addressLanding.RETURN,
          classes: "govuk-button--secondary"
        }) }}
      </div>
      <p class="govuk-body"><a class="govuk-link" href="{{ cancelHref }}">{{ copy.add.cancelToHub }}</a></p>
    {% elif addMode == addModes.CONSIGNMENT_CONTACT %}
      <div class="govuk-button-group">
        {{ govukButton({ text: copy.add.save }) }}
        {{ govukButton({
          text: copy.add.cancelAndReturnToAddressPage,
          name: "cancel",
          value: "true",
          classes: "govuk-button--secondary"
        }) }}
      </div>
    {% else %}
      <div class="govuk-button-group">
        {{ govukButton({ text: copy.add.save }) }}
      </div>
      <p class="govuk-body"><a class="govuk-link" href="{{ cancelHref }}">{{ copy.add.cancel }}</a></p>
    {% endif %}

  </form>

{% endblock %}
