{% extends "shared/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "address-book/address-fields.njk" import addressFields %}

{% block journeyContent %}
  {% include "shared/error-summary.njk" %}

  <h1 class="govuk-heading-l">{{ copy.edit.title }}</h1>

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}" />

    {{ addressFields({
      copy: copy,
      formValues: formValues,
      countryItems: countryItems,
      errors: errors
    }) }}

    <div class="govuk-button-group">
      {{ govukButton({ text: copy.edit.save }) }}
      {{ govukButton({
        text: copy.edit.cancel,
        name: "cancel",
        value: "true",
        classes: "govuk-button--secondary"
      }) }}
    </div>

  </form>

{% endblock %}
