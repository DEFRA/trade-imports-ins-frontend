{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block content %}

  {{ appHeading({
    text: heading,
    caption: "EUDPA-390 — dev/local only, temporary"
  }) }}

  <div class="govuk-body" data-testid="app-page-body">

    <form method="post" novalidate>
      <input type="hidden" name="crumb" value="{{ crumb }}" />
      {{ govukButton({ text: "Test the address lookup" }) }}
    </form>

    {% if networkError %}
      {{ govukWarningText({
        text: "The address lookup request failed before the backend could answer.",
        iconFallbackText: "Warning"
      }) }}
    {% endif %}

    {% if response %}

      {% if response.outcome == "RESULTS" %}
        {{ govukTag({ text: "Results", classes: "govuk-tag--green" }) }}
      {% elif response.outcome == "NO_RESULTS" %}
        {{ govukTag({ text: "No results", classes: "govuk-tag--grey" }) }}
      {% else %}
        {{ govukTag({ text: "Failed", classes: "govuk-tag--red" }) }}
      {% endif %}

      <h2 class="govuk-heading-m">Query</h2>
      {{ govukSummaryList({
        rows: [
          { key: { text: "Mode" }, value: { text: response.query.mode } },
          { key: { text: "Term" }, value: { text: response.query.term } }
        ]
      }) }}

      {% if resultRows.length %}
        <h2 class="govuk-heading-m">Results ({{ response.returnedResults }} of {{ response.totalResults }})</h2>
        {{ govukTable({
          head: [
            { text: "Address line" },
            { text: "Postcode" },
            { text: "Match" },
            { text: "UPRN" }
          ],
          rows: resultRows
        }) }}
      {% endif %}

      {% if response.outcome == "FAILED" and response.failureReason %}
        {{ govukWarningText({
          text: "Lookup failed: " + response.failureReason,
          iconFallbackText: "Warning"
        }) }}
      {% endif %}

      {{ govukDetails({
        summaryText: "Raw response",
        html: '<pre class="govuk-body">' + (responseJson | escape) + '</pre>'
      }) }}

    {% endif %}

  </div>

{% endblock %}
